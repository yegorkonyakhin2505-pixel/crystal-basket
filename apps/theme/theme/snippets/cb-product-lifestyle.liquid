{%- comment -%}
  Second product photo (on the wrist) from the theme assets, for products whose Shopify listing has only the main photo.
  Generated by scripts/build-data.ts from apps/web/public/images/products/<handle>/lifestyle.jpg; do not edit.
  Renders nothing when the product has no lifestyle photo. {% render 'cb-product-lifestyle', handle: product.handle, alt: '…', sizes: '…' %}
{%- endcomment -%}
{%- case handle -%}
  {%- when "the-alchemist" -%}{%- render 'cb-img', src: '/images/products/the-alchemist/lifestyle.jpg', alt: alt, sizes: sizes, class: class -%}
  {%- when "the-aurora" -%}{%- render 'cb-img', src: '/images/products/the-aurora/lifestyle.jpg', alt: alt, sizes: sizes, class: class -%}
  {%- when "the-devotion" -%}{%- render 'cb-img', src: '/images/products/the-devotion/lifestyle.jpg', alt: alt, sizes: sizes, class: class -%}
  {%- when "the-fortune" -%}{%- render 'cb-img', src: '/images/products/the-fortune/lifestyle.jpg', alt: alt, sizes: sizes, class: class -%}
  {%- when "the-guardian" -%}{%- render 'cb-img', src: '/images/products/the-guardian/lifestyle.jpg', alt: alt, sizes: sizes, class: class -%}
  {%- when "the-seven" -%}{%- render 'cb-img', src: '/images/products/the-seven/lifestyle.jpg', alt: alt, sizes: sizes, class: class -%}
  {%- when "the-shield" -%}{%- render 'cb-img', src: '/images/products/the-shield/lifestyle.jpg', alt: alt, sizes: sizes, class: class -%}
{%- endcase -%}
