<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  {%- render 'cb-meta' -%}
  <link rel="icon" href="{{ 'cb-favicon.svg' | asset_url }}" type="image/svg+xml">
  <link rel="icon" href="{{ 'cb-favicon.ico' | asset_url }}" sizes="32x32">
  <link rel="icon" href="{{ 'cb-icon-192.png' | asset_url }}" sizes="192x192" type="image/png">
  <link rel="apple-touch-icon" href="{{ 'cb-apple-touch-icon.png' | asset_url }}">
  {{ '9dd75fadc5b3df29-s.p.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ '7b89a4fd5e90ede0-s.p.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  <link rel="stylesheet" href="{{ 'cb-fonts.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'cb-theme.css' | asset_url }}">
  <script src="{{ 'cb-islands.js' | asset_url }}" defer></script>
  <script>document.documentElement.classList.add('js')</script>
  {%- render 'cb-schema-site' -%}
  {{ content_for_header }}
</head>
<body class="min-h-screen flex flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-white focus:px-4 focus:py-2">Skip to content</a>
  {% sections 'header-group' %}
  <main id="main" class="flex-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  {%- render 'cb-island', name: 'NewsletterBar' -%}
  {%- render 'cb-island', name: 'OfferPopup' -%}
  {%- render 'cb-island', name: 'CartDrawer' -%}
  {%- capture cb_search_props -%}{ "items": {% render 'cb-search-index' %} }{%- endcapture -%}
  {%- render 'cb-island', name: 'SearchDialog', props: cb_search_props -%}
  {%- render 'cb-config' -%}
</body>
</html>
