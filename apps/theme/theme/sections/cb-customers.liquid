{%- comment -%}
  Customer account pages, one section for all seven templates (login, register, account, addresses, order,
  activate_account, reset_password), switched on template.name. Minimal, on-brand, Shopify's standard forms.
{%- endcomment -%}
{%- liquid
  assign input = 'h-11 w-full border border-cb-line bg-white px-4 text-[14px] text-cb-ink placeholder:text-cb-faint focus:border-cb-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cb-rose transition-colors'
  assign button = 'inline-flex select-none items-center justify-center gap-2 font-medium uppercase tracking-[0.14em] transition-colors duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cb-rose disabled:cursor-not-allowed disabled:opacity-50 bg-cb-ink text-white hover:bg-black h-11 px-6 text-[12px]'
  assign outline = 'inline-flex select-none items-center justify-center gap-2 font-medium uppercase tracking-[0.14em] transition-colors duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cb-rose disabled:cursor-not-allowed disabled:opacity-50 border border-cb-ink bg-transparent text-cb-ink hover:bg-cb-ink hover:text-white h-11 px-6 text-[12px]'
-%}
<section class="container-x pt-12 md:pt-20 pb-20 max-w-3xl">
  <p class="label-caps mb-3">Account</p>
  {%- case template.name -%}

  {%- when 'login' -%}
    <h1 class="text-4xl md:text-[3rem] mb-8">Sign in</h1>
    <div class="grid md:grid-cols-2 gap-10">
      <div>
        {% form 'customer_login', class: 'space-y-3' %}
          {%- if form.errors -%}<p class="text-[12px] text-cb-danger">{{ form.errors | default_errors }}</p>{%- endif -%}
          <label for="login-email" class="sr-only">Email</label>
          <input id="login-email" type="email" name="customer[email]" autocomplete="email" placeholder="Email" class="{{ input }}">
          <label for="login-password" class="sr-only">Password</label>
          <input id="login-password" type="password" name="customer[password]" autocomplete="current-password" placeholder="Password" class="{{ input }}">
          <button type="submit" class="{{ button }} w-full">Sign in</button>
          <p class="text-[13px] text-cb-muted">New here? <a href="{{ routes.account_register_url }}" class="text-cb-ink underline underline-offset-4">Create an account</a>.</p>
        {% endform %}
      </div>
      <div>
        <p class="label-caps mb-3">Forgot your password?</p>
        {% form 'recover_customer_password', class: 'space-y-3' %}
          {%- if form.posted_successfully? -%}<p class="text-[13px] text-cb-success">We emailed you a link to reset your password.</p>{%- endif -%}
          {%- if form.errors -%}<p class="text-[12px] text-cb-danger">{{ form.errors | default_errors }}</p>{%- endif -%}
          <label for="recover-email" class="sr-only">Email</label>
          <input id="recover-email" type="email" name="email" autocomplete="email" placeholder="Email" class="{{ input }}">
          <button type="submit" class="{{ outline }} w-full">Send reset link</button>
        {% endform %}
      </div>
    </div>

  {%- when 'register' -%}
    <h1 class="text-4xl md:text-[3rem] mb-8">Create an account</h1>
    {% form 'create_customer', class: 'space-y-3 max-w-md' %}
      {%- if form.errors -%}<p class="text-[12px] text-cb-danger">{{ form.errors | default_errors }}</p>{%- endif -%}
      <input type="text" name="customer[first_name]" autocomplete="given-name" placeholder="First name" aria-label="First name" class="{{ input }}">
      <input type="text" name="customer[last_name]" autocomplete="family-name" placeholder="Last name" aria-label="Last name" class="{{ input }}">
      <input type="email" name="customer[email]" autocomplete="email" placeholder="Email" aria-label="Email" class="{{ input }}">
      <input type="password" name="customer[password]" autocomplete="new-password" placeholder="Password" aria-label="Password" class="{{ input }}">
      <button type="submit" class="{{ button }} w-full">Create account</button>
      <p class="text-[13px] text-cb-muted">Already have one? <a href="{{ routes.account_login_url }}" class="text-cb-ink underline underline-offset-4">Sign in</a>.</p>
    {% endform %}

  {%- when 'account' -%}
    <h1 class="text-4xl md:text-[3rem] mb-2">Hello, {{ customer.first_name | default: customer.email }}</h1>
    <p class="text-[13px] text-cb-muted mb-8"><a href="{{ routes.account_addresses_url }}" class="underline underline-offset-4 hover:text-cb-ink">Addresses</a> · <a href="{{ routes.account_logout_url }}" class="underline underline-offset-4 hover:text-cb-ink">Sign out</a></p>
    <h2 class="label-caps mb-3">Orders</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size == 0 -%}
        <p class="text-[14px] text-cb-muted">No orders yet. <a href="{{ routes.all_products_collection_url }}" class="text-cb-ink underline underline-offset-4">Browse bracelets</a>.</p>
      {%- else -%}
        <ul class="border-t border-cb-line">
          {%- for order in customer.orders -%}
            <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-cb-line py-4 text-[14px]">
              <a href="{{ order.customer_url }}" class="font-display text-xl hover:text-cb-rose">{{ order.name }}</a>
              <span class="text-cb-muted">{{ order.created_at | date: '%-d %B %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</span>
              <span class="price text-[14px]">{{ order.total_price | divided_by: 100 }} AED</span>
            </li>
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}<nav class="py-6 text-[13px] text-cb-muted">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}

  {%- when 'addresses' -%}
    <h1 class="text-4xl md:text-[3rem] mb-8">Addresses</h1>
    <ul class="border-t border-cb-line mb-10">
      {%- for address in customer.addresses -%}
        <li class="border-b border-cb-line py-4 text-[14px]">
          {{ address | format_address }}
          {%- if address == customer.default_address -%}<p class="label-caps mt-2">Default</p>{%- endif -%}
          <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" class="mt-2"><input type="hidden" name="_method" value="delete"><button type="submit" class="text-[11px] uppercase tracking-[0.14em] text-cb-muted underline underline-offset-4 hover:text-cb-rose">Remove</button></form>
        </li>
      {%- endfor -%}
      {%- if customer.addresses.size == 0 -%}<li class="py-4 text-[14px] text-cb-muted">No saved addresses.</li>{%- endif -%}
    </ul>
    <h2 class="label-caps mb-3">Add an address</h2>
    {% form 'customer_address', customer.new_address, class: 'space-y-3 max-w-md' %}
      <input type="text" name="address[first_name]" placeholder="First name" aria-label="First name" class="{{ input }}">
      <input type="text" name="address[last_name]" placeholder="Last name" aria-label="Last name" class="{{ input }}">
      <input type="text" name="address[address1]" placeholder="Address" aria-label="Address" class="{{ input }}">
      <input type="text" name="address[address2]" placeholder="Apartment, villa, area (optional)" aria-label="Address line 2" class="{{ input }}">
      <input type="text" name="address[city]" placeholder="City" aria-label="City" class="{{ input }}">
      <select name="address[country]" aria-label="Country" class="{{ input }}" data-default="United Arab Emirates">{{ country_option_tags }}</select>
      <input type="text" name="address[province]" placeholder="Emirate" aria-label="Emirate" class="{{ input }}">
      <input type="tel" name="address[phone]" placeholder="Phone" aria-label="Phone" class="{{ input }}">
      <label class="flex items-center gap-2 text-[13px]"><input type="checkbox" name="address[default]" value="1"> Set as default</label>
      <button type="submit" class="{{ button }} w-full">Save address</button>
    {% endform %}
    <p class="text-[13px] text-cb-muted mt-6"><a href="{{ routes.account_url }}" class="underline underline-offset-4 hover:text-cb-ink">Back to your account</a></p>

  {%- when 'order' -%}
    <h1 class="text-4xl md:text-[3rem] mb-2">Order {{ order.name }}</h1>
    <p class="text-[13px] text-cb-muted mb-8">{{ order.created_at | date: '%-d %B %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
    <ul class="divide-y divide-cb-line border-t border-cb-line">
      {%- for line in order.line_items -%}
        <li class="flex gap-4 py-4">
          <div class="h-20 w-20 shrink-0 bg-cb-band overflow-hidden">{% if line.image %}<img src="{{ line.image | image_url: width: 240 }}" alt="" class="h-full w-full object-cover" width="80" height="80" loading="lazy">{% endif %}</div>
          <div class="flex-1 min-w-0">
            <p class="font-display text-[1.15rem] leading-tight">{{ line.title }}</p>
            <p class="text-[12px] text-cb-muted">{{ line.variant.title }}{% if line.quantity > 1 %} × {{ line.quantity }}{% endif %}</p>
            {%- for prop in line.properties -%}{%- assign first_char = prop.first | slice: 0 -%}{%- if first_char == '_' or prop.last == blank -%}{%- continue -%}{%- endif -%}<p class="text-[11px] text-cb-muted mt-0.5"><span class="text-cb-faint">{{ prop.first }}:</span> {{ prop.last }}</p>{%- endfor -%}
          </div>
          <p class="price text-[15px]">{{ line.final_line_price | divided_by: 100 }} AED</p>
        </li>
      {%- endfor -%}
    </ul>
    <div class="border-t border-cb-line py-5 space-y-1 text-[14px]">
      <div class="flex justify-between"><span>Subtotal</span><span class="price text-[14px]">{{ order.line_items_subtotal_price | divided_by: 100 }} AED</span></div>
      {%- for d in order.discount_applications -%}<div class="flex justify-between text-cb-muted"><span>{{ d.title }}</span><span>− {{ d.total_allocated_amount | divided_by: 100 }} AED</span></div>{%- endfor -%}
      <div class="flex justify-between"><span>Delivery</span><span class="price text-[14px]">{{ order.shipping_price | divided_by: 100 }} AED</span></div>
      <div class="flex justify-between font-medium text-[16px] pt-2"><span>Total</span><span class="price text-[18px]">{{ order.total_price | divided_by: 100 }} AED</span></div>
    </div>
    {%- if order.shipping_address -%}<h2 class="label-caps mt-8 mb-2">Delivery address</h2><div class="text-[14px] text-cb-muted">{{ order.shipping_address | format_address }}</div>{%- endif -%}
    <p class="text-[13px] text-cb-muted mt-8"><a href="{{ routes.account_url }}" class="underline underline-offset-4 hover:text-cb-ink">Back to your account</a></p>

  {%- when 'activate_account' -%}
    <h1 class="text-4xl md:text-[3rem] mb-8">Activate your account</h1>
    {% form 'activate_customer_password', class: 'space-y-3 max-w-md' %}
      {%- if form.errors -%}<p class="text-[12px] text-cb-danger">{{ form.errors | default_errors }}</p>{%- endif -%}
      <input type="password" name="customer[password]" autocomplete="new-password" placeholder="Password" aria-label="Password" class="{{ input }}">
      <input type="password" name="customer[password_confirmation]" autocomplete="new-password" placeholder="Confirm password" aria-label="Confirm password" class="{{ input }}">
      <button type="submit" class="{{ button }} w-full">Activate</button>
      <button type="submit" name="decline" class="{{ outline }} w-full">Decline invitation</button>
    {% endform %}

  {%- when 'reset_password' -%}
    <h1 class="text-4xl md:text-[3rem] mb-8">Choose a new password</h1>
    {% form 'reset_customer_password', class: 'space-y-3 max-w-md' %}
      {%- if form.errors -%}<p class="text-[12px] text-cb-danger">{{ form.errors | default_errors }}</p>{%- endif -%}
      <input type="password" name="customer[password]" autocomplete="new-password" placeholder="New password" aria-label="New password" class="{{ input }}">
      <input type="password" name="customer[password_confirmation]" autocomplete="new-password" placeholder="Confirm password" aria-label="Confirm password" class="{{ input }}">
      <button type="submit" class="{{ button }} w-full">Save password</button>
    {% endform %}

  {%- else -%}
    <h1 class="text-4xl md:text-[3rem]">Account</h1>
  {%- endcase -%}
</section>
{% schema %}
{ "name": "Customer account", "settings": [] }
{% endschema %}
