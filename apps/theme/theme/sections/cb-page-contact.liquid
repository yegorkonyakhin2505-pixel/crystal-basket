{%- comment -%} Contact (mirror of apps/web contact/page.tsx): email, Instagram, and WhatsApp when the flag is on. {%- endcomment -%}
{%- liquid
  assign page_abs = shop.url | append: page.url
  assign wa_url = 'https://wa.me/' | append: settings.cb_whatsapp | append: '?text=Hi%20Crystal%20Basket!'
-%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ shop.url }}/"},{"@type":"ListItem","position":2,"name":"Contact","item":"{{ page_abs }}"}]}</script>
{%- capture intro -%}<p>Questions about an order, a size, a custom length or which stones to choose all come to the same small studio in {{ settings.cb_city }}, United Arab Emirates.</p>{%- endcapture -%}
{%- render 'cb-page-intro', heading: 'Contact Crystal Basket', tagline: 'Write to us.', content: intro -%}
<section class="container-x pb-12 max-w-3xl">
  <ul class="border-t border-cb-line">
    <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-cb-line py-5">
      <span class="label-caps">Email</span>
      <a href="mailto:{{ settings.cb_email }}" class="font-display text-2xl hover:text-cb-rose break-all">{{ settings.cb_email }}</a>
    </li>
    <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-cb-line py-5">
      <span class="label-caps">Instagram</span>
      <a href="https://www.instagram.com/{{ settings.cb_instagram }}/" target="_blank" rel="noopener" class="font-display text-2xl hover:text-cb-rose break-all">@{{ settings.cb_instagram }}</a>
    </li>
    {%- if settings.cb_whatsapp_on -%}
    <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-cb-line py-5">
      <span class="label-caps">WhatsApp</span>
      <a href="{{ wa_url }}" target="_blank" rel="noopener" class="font-display text-2xl hover:text-cb-rose break-all">+{{ settings.cb_whatsapp }}</a>
    </li>
    {%- endif -%}
  </ul>
</section>
<section class="container-x pb-20 max-w-3xl">
  <h2 class="text-3xl md:text-[2.25rem]">What should I include?</h2>
  <p class="text-cb-muted mt-3 leading-relaxed">For an existing order, include the order name from your confirmation email. For a custom length, include your wrist measurement in centimetres. Answers to the most common questions are in the <a href="/pages/faq" class="text-cb-ink underline underline-offset-4">FAQ</a>, and delivery and exchange details are on the <a href="/pages/delivery" class="text-cb-ink underline underline-offset-4">delivery</a> and <a href="/pages/returns" class="text-cb-ink underline underline-offset-4">exchanges</a> pages.</p>
</section>
{% schema %}
{ "name": "Contact page", "settings": [] }
{% endschema %}
