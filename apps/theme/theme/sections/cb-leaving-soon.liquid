{%- comment -%}
  "Leaving soon" strip: one-off studio pieces (cb.leaving_soon) that are still in stock. Hidden until there are at least two.
{%- endcomment -%}
{%- liquid
  assign shop_url = routes.all_products_collection_url
  assign bracelets = collections.all.products | sort: 'handle'
  assign shown = 0
  capture tiles
    for p in bracelets
      unless p.metafields.crystal.intention.value
        continue
      endunless
      if p.metafields.crystal.leaving_soon.value and p.available
        assign shown = shown | plus: 1
        render 'cb-product-tile', product: p
      endif
    endfor
  endcapture
-%}
{%- if shown >= 2 -%}
<section class="bg-cb-band py-16 md:py-24">
  <div class="container-x">
    {%- render 'cb-section-title', eyebrow: 'Leaving soon', title: section.settings.title, text: section.settings.text -%}
  </div>
  <div class="grid grid-cols-2 lg:grid-cols-4 border-t border-l border-cb-line">{{ tiles }}</div>
  <div class="container-x mt-8 text-center"><a href="{{ shop_url }}" class="inline-flex select-none items-center justify-center gap-2 font-medium uppercase tracking-[0.14em] transition-colors duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cb-rose disabled:cursor-not-allowed disabled:opacity-50 border border-cb-ink bg-transparent text-cb-ink hover:bg-cb-ink hover:text-white h-11 px-6 text-[12px]">Shop all bracelets</a></div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Leaving soon",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "One-off studio pieces" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "One-off pieces from the studio, separate from our regular line. We have them in hand today and will not restring them once they sell out." }
  ],
  "presets": [{ "name": "Leaving soon" }]
}
{% endschema %}
