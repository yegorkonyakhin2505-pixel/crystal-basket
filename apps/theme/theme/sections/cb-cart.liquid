{%- comment -%}
  /cart as a page (the bag drawer is the usual path). Same look as CartDrawer.tsx: lines, remove links, subtotal, checkout.
{%- endcomment -%}
{%- liquid
  assign fee = settings.cb_delivery_fee | default: 25
  assign free = settings.cb_free_delivery | default: 250
  assign delivery_copy = settings.cb_delivery_copy | default: 'Next-day delivery across the UAE.'
-%}
<section class="container-x pt-12 md:pt-20 pb-20 max-w-3xl">
  <p class="label-caps mb-3">Bag</p>
  <h1 class="text-4xl md:text-[3rem] mb-10">Your bag <span class="text-cb-muted text-[14px] font-body">({{ cart.item_count }})</span></h1>
  {%- if cart.item_count == 0 -%}
    <div class="py-16 text-center text-cb-muted">{% render 'cb-icon', name: 'shopping-bag', class: 'h-8 w-8 mx-auto mb-3', stroke: 1.2 %}<p>Your bag is empty.</p></div>
    <div class="text-center"><a href="{{ routes.all_products_collection_url }}" class="inline-flex select-none items-center justify-center gap-2 font-medium uppercase tracking-[0.14em] transition-colors duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cb-rose disabled:cursor-not-allowed disabled:opacity-50 border border-cb-ink bg-transparent text-cb-ink hover:bg-cb-ink hover:text-white h-11 px-6 text-[12px]">Browse bracelets</a></div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <ul class="divide-y divide-cb-line">
        {%- for item in cart.items -%}
          <li class="flex gap-4 py-4">
            <div class="h-20 w-20 shrink-0 bg-cb-band overflow-hidden">{% if item.image %}<img src="{{ item.image | image_url: width: 240 }}" alt="" class="h-full w-full object-cover" width="80" height="80" loading="lazy">{% endif %}</div>
            <div class="flex-1 min-w-0">
              <p class="font-display text-[1.15rem] leading-tight">{{ item.product.title }}</p>
              <p class="text-[12px] text-cb-muted">{{ item.variant.title }}{% if item.quantity > 1 %} × {{ item.quantity }}{% endif %}</p>
              {%- for prop in item.properties -%}
                {%- assign first_char = prop.first | slice: 0 -%}
                {%- if first_char == '_' or prop.last == blank -%}{%- continue -%}{%- endif -%}
                <p class="text-[11px] text-cb-muted mt-0.5 line-clamp-2"><span class="text-cb-faint">{{ prop.first }}:</span> {{ prop.last }}</p>
              {%- endfor -%}
              <a href="{{ item.url_to_remove }}" class="inline-block text-[11px] uppercase tracking-[0.14em] text-cb-muted underline underline-offset-4 mt-2 hover:text-cb-rose">Remove</a>
            </div>
            <p class="price text-[15px]">{{ item.final_line_price | divided_by: 100 }} AED</p>
          </li>
        {%- endfor -%}
      </ul>
      <div class="border-t border-cb-line py-5 space-y-3">
        <div class="flex justify-between text-[15px]"><span>Subtotal</span><span class="price">{{ cart.items_subtotal_price | divided_by: 100 }} AED</span></div>
        <p class="text-[11px] text-cb-muted">Delivery {{ fee }} AED, free over {{ free }} AED. Discount codes are applied at checkout. {{ delivery_copy }}</p>
        <button type="submit" name="checkout" class="inline-flex h-12 w-full items-center justify-center text-[12px] uppercase tracking-[0.14em] transition-colors bg-cb-ink text-white hover:bg-black">Checkout</button>
      </div>
    </form>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
