{%- comment -%}
  Shop page (mirror of apps/web shop/page.tsx) for /collections/all, and a plain listing for any other collection.
  Listing hero, FilterBar island, four-up grid with in-stock pieces first, then bestsellers, then featured pieces,
  catalog order (handle) otherwise. Only products with the cb.intention metafield are bracelets.
{%- endcomment -%}
{%- liquid
  assign fee = settings.cb_delivery_fee | default: 25
  assign free = settings.cb_free_delivery | default: 250
  assign pct = settings.cb_stack_discount | default: 15
  assign city = settings.cb_city | default: 'Dubai'
  assign is_all = false
  if collection.handle == 'all'
    assign is_all = true
  endif
  if is_all
    assign title = 'Crystal bracelets'
    assign crumbs = '|Bracelets'
    assign description = 'Every Crystal Basket bracelet, hand-strung in Dubai.'
    assign text = 'Twelve natural crystal bracelets in 8 mm stone, from 65 AED, hand-strung and cleansed in ' | append: city | append: ' before they ship. Delivery across the UAE is ' | append: fee | append: ' AED, free over ' | append: free | append: ' AED, and any three bracelets are ' | append: pct | append: '% off as a stack. Start with the feeling you want more of.'
  else
    assign title = collection.title
    assign crumbs = routes.all_products_collection_url | append: '|Bracelets||' | append: '|' | append: collection.title
    assign description = collection.description | strip_html | default: title
    assign text = collection.description | strip_html
  endif
-%}
{%- paginate collection.products by 250 -%}
{%- assign sorted = collection.products | sort: 'handle' -%}
{%- assign total = 0 -%}
{%- for p in sorted -%}{%- if p.metafields.crystal.intention.value -%}{%- assign total = total | plus: 1 -%}{%- endif -%}{%- endfor -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ shop.url }}/"},{% unless is_all %}{"@type":"ListItem","position":2,"name":"Bracelets","item":"{{ shop.url }}{{ routes.all_products_collection_url }}"},{% endunless %}{"@type":"ListItem","position":{% if is_all %}2{% else %}3{% endif %},"name":{{ title | json }},"item":"{{ shop.url }}{{ collection.url }}"}]}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"CollectionPage","@id":"{{ shop.url }}{{ collection.url }}","url":"{{ shop.url }}{{ collection.url }}","name":{{ title | json }},"description":{{ description | json }},"isPartOf":{"@id":"{{ shop.url }}/#website"},"mainEntity":{"@type":"ItemList","name":{{ title | json }},"numberOfItems":{{ total }},"itemListElement":[{%- assign pos = 0 -%}{%- for p in sorted -%}{%- unless p.metafields.crystal.intention.value -%}{%- continue -%}{%- endunless -%}{%- assign pos = pos | plus: 1 -%}{% if pos > 1 %},{% endif %}{"@type":"ListItem","position":{{ pos }},"name":{{ p.title | json }},"url":"{{ shop.url }}{{ p.url }}"{% if p.featured_image %},"image":{{ p.featured_image | image_url: width: 1200 | json }}{% endif %}}{%- endfor -%}]}}
</script>
{%- if is_all -%}
  {%- render 'cb-listing-hero', image: '/images/hero/hero-2.jpg', alt: 'Crystal bracelets stacked on a wrist', crumbs: crumbs, title: title, text: text -%}
{%- elsif collection.image -%}
  {%- render 'cb-listing-hero', image_obj: collection.image, alt: collection.title, crumbs: crumbs, title: title, text: text -%}
{%- else -%}
  {%- render 'cb-listing-hero', image: '/images/hero/hero-2.jpg', alt: 'Crystal bracelets stacked on a wrist', crumbs: crumbs, title: title, text: text -%}
{%- endif -%}

{%- capture filter_props -%}
{ "gridId": "shop-grid", "total": {{ total }}, "intentions": [
{%- assign n_out = 0 -%}
{%- for n in (1..12) -%}
  {%- for i in shop.metaobjects.intention.values -%}
    {%- assign order = i.sort_order.value | plus: 0 -%}
    {%- if order == n -%}
      {%- if n_out > 0 -%},{%- endif -%}{"id":{{ i.system.handle | json }},"label":{{ i.name.value | json }}}
      {%- assign n_out = n_out | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
], "stones": [
{%- for s in shop.metaobjects.stone.values -%}
  {%- if s.image.value -%}{%- assign s_img = s.image.value | image_url: width: 56 -%}{%- else -%}{%- assign s_img = 'cb-stones-' | append: s.system.handle | append: '.jpg' | asset_url -%}{%- endif -%}
  {"id":{{ s.system.handle | json }},"label":{{ s.name.value | json }},"image":{{ s_img | json }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
] }
{%- endcapture -%}
{%- render 'cb-island', name: 'FilterBar', props: filter_props, class: 'contents' -%}

{%- if total == 0 -%}
  <p class="container-x py-10 text-[14px] text-cb-muted">New pieces are being strung. Check back soon.</p>
{%- else -%}
<div id="shop-grid" class="grid grid-cols-2 lg:grid-cols-4 border-t border-l border-cb-line">
  {%- assign shown = 0 -%}
  {%- for pass in (1..6) -%}
    {%- for p in sorted -%}
      {%- unless p.metafields.crystal.intention.value -%}{%- continue -%}{%- endunless -%}
      {%- assign best = p.metafields.crystal.bestseller.value -%}
      {%- assign feat = p.metafields.crystal.featured.value -%}
      {%- assign ok = false -%}
      {%- case pass -%}
        {%- when 1 -%}{%- if p.available and best -%}{%- assign ok = true -%}{%- endif -%}
        {%- when 2 -%}{%- if p.available and best != true and feat -%}{%- assign ok = true -%}{%- endif -%}
        {%- when 3 -%}{%- if p.available and best != true and feat != true -%}{%- assign ok = true -%}{%- endif -%}
        {%- when 4 -%}{%- if p.available == false and best -%}{%- assign ok = true -%}{%- endif -%}
        {%- when 5 -%}{%- if p.available == false and best != true and feat -%}{%- assign ok = true -%}{%- endif -%}
        {%- when 6 -%}{%- if p.available == false and best != true and feat != true -%}{%- assign ok = true -%}{%- endif -%}
      {%- endcase -%}
      {%- if ok -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- if shown <= 4 -%}{%- render 'cb-product-tile', product: p, eager: true -%}{%- else -%}{%- render 'cb-product-tile', product: p -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
</div>
{%- endif -%}
{%- endpaginate -%}
{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
