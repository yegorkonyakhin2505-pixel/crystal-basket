{%- comment -%}
  Stone library (mirror of apps/web stones/page.tsx): listing hero, tumbled-stone photo tiles in name order with a
  bracelet count each, then the "N stones at a glance" table. Stones are metaobjects of type `stone`.
{%- endcomment -%}
{%- liquid
  assign hub_url = page.url | default: '/pages/stones'
  assign hub_abs = shop.url | append: hub_url
  assign care_url = '/pages/care'
  capture names
    for s in shop.metaobjects.stone.values
      echo s.name.value
      unless forloop.last
        echo '||'
      endunless
    endfor
  endcapture
  assign names = names | split: '||' | sort_natural
  assign stone_count = names.size
  assign hero_text = stone_count | append: ' stones we trust enough to string. What each one is traditionally worn for, which chakra it belongs to, which wrist to wear it on and how to look after it.'
  assign n_ld = 0
-%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ shop.url }}/"},{"@type":"ListItem","position":2,"name":"Stones","item":"{{ hub_abs }}"}]}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","@id":"{{ hub_abs }}","url":"{{ hub_abs }}","name":"Crystal meanings","description":"The natural stones Crystal Basket strings, and what each is traditionally worn for.","isPartOf":{"@id":"{{ shop.url }}/#website"},"mainEntity":{"@type":"ItemList","name":"Crystal meanings","numberOfItems":{{ stone_count }},"itemListElement":[
{%- for nm in names -%}
  {%- for s in shop.metaobjects.stone.values -%}
    {%- if s.name.value == nm -%}
      {%- if n_ld > 0 -%},{%- endif -%}{%- assign n_ld = n_ld | plus: 1 -%}
      {"@type":"ListItem","position":{{ n_ld }},"name":{{ s.name.value | json }},"url":{{ shop.url | append: s.system.url | json }}}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
]}}</script>

{%- render 'cb-listing-hero', image: '/images/about/studio.jpg', alt: 'Gemstone beads on the studio table', crumbs: '|Stones', title: 'Crystal meanings', text: hero_text -%}

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 border-t border-l border-cb-line">
  {%- for nm in names -%}
    {%- for s in shop.metaobjects.stone.values -%}
      {%- if s.name.value == nm -%}
        {%- assign sh = s.system.handle -%}
        {%- assign count = 0 -%}
        {%- for p in collections.all.products -%}
          {%- if p.metafields.crystal.intention.value -%}
            {%- capture ph -%}{%- for ps in p.metafields.crystal.stones.value -%}{{ ps.system.handle }} {% endfor -%}{%- endcapture -%}
            {%- assign phs = ph | split: ' ' -%}
            {%- if phs contains sh -%}{%- assign count = count | plus: 1 -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <a href="{{ s.system.url | default: '#' }}" class="group bg-white p-6 border-r border-b border-cb-line">
          {%- if s.image.value -%}
            {%- assign alt = s.name.value | append: ' tumbled stone' -%}
            <div class="aspect-square mx-auto w-3/5 transition-transform duration-700 group-hover:scale-[1.04]">{{ s.image.value | image_url: width: 800 | image_tag: widths: '240, 480, 800', sizes: '(min-width: 1024px) 15vw, 30vw', loading: 'lazy', alt: alt, class: 'block h-full w-full object-cover' }}</div>
          {%- else -%}
            <div class="aspect-square rounded-full mx-auto w-3/4 ring-1 ring-black/5 transition-transform duration-700 group-hover:scale-[1.04]" style="background: radial-gradient(circle at 38% 32%, rgb(255 255 255 / 0.67) 0%, transparent 18%), radial-gradient(circle at 40% 35%, {{ s.palette_1.value }}, {{ s.palette_2.value }})"></div>
          {%- endif -%}
          <p class="font-display text-[1.3rem] mt-6 text-center group-hover:text-cb-rose transition-colors">{{ s.name.value }}</p>
          <p class="text-[12px] text-cb-muted text-center mt-1">{{ s.keywords.value | join: ' · ' }}</p>
          <p class="text-[11px] text-cb-faint text-center mt-2 uppercase tracking-[0.14em]">{{ count }} bracelet{% if count != 1 %}s{% endif %}</p>
        </a>
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
</div>

<section class="container-x py-16 md:py-20">
  <h2 class="text-3xl md:text-[2.5rem] mb-6">{{ stone_count }} stones at a glance</h2>
  <div class="overflow-x-auto border border-cb-line">
    <table class="w-full min-w-[720px] text-[14px]">
      <caption class="sr-only">Crystal meanings, chakras, wrist and care for each stone</caption>
      <thead class="bg-cb-band text-left">
        <tr><th scope="col" class="px-4 py-3 label-caps font-medium">Stone</th><th scope="col" class="px-4 py-3 label-caps font-medium">Traditionally worn for</th><th scope="col" class="px-4 py-3 label-caps font-medium">Chakra</th><th scope="col" class="px-4 py-3 label-caps font-medium">Wrist</th><th scope="col" class="px-4 py-3 label-caps font-medium">Water</th><th scope="col" class="px-4 py-3 label-caps font-medium">Sun</th><th scope="col" class="px-4 py-3 label-caps font-medium">Mohs</th></tr>
      </thead>
      <tbody class="divide-y divide-cb-line">
        {%- for nm in names -%}
          {%- for s in shop.metaobjects.stone.values -%}
            {%- if s.name.value == nm -%}
              <tr>
                <th scope="row" class="px-4 py-3 text-left font-normal"><a href="{{ s.system.url | default: '#' }}" class="underline underline-offset-4 hover:text-cb-rose">{{ s.name.value }}</a></th>
                <td class="px-4 py-3">{{ s.keywords.value | join: ', ' }}</td>
                <td class="px-4 py-3">{{ s.chakra.value | join: ', ' }}</td>
                <td class="px-4 py-3">{% case s.wrist.value %}{% when 'left' %}Left{% when 'right' %}Right{% else %}Either{% endcase %}</td>
                <td class="px-4 py-3">{% if s.water_safe.value == false %}Keep dry{% else %}Brief rinse{% endif %}</td>
                <td class="px-4 py-3">{% if s.sun_safe.value == false %}Fades{% else %}Fine{% endif %}</td>
                <td class="px-4 py-3 tabular-nums">{{ s.mohs.value }}</td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </tbody>
    </table>
  </div>
  <p class="text-[12px] text-cb-faint mt-3">Crystal meanings describe traditional beliefs, not medical advice. <a href="{{ care_url }}" class="underline underline-offset-4">How to cleanse and care for each stone</a>.</p>
</section>
{% schema %}
{ "name": "Stone library", "settings": [] }
{% endschema %}
