{% layout none %}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="icon" href="{{ 'cb-favicon.svg' | asset_url }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ 'cb-fonts.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'cb-theme.css' | asset_url }}">
  {{ content_for_header }}
</head>
<body class="min-h-screen flex flex-col">
  <main class="flex-1 flex items-center justify-center">
    <section class="container-x py-24 text-center max-w-md">
      {% render 'cb-logo-badge', class: 'h-16 w-16 mx-auto mb-6' %}
      {% render 'cb-wordmark', class: 'text-[1.4rem]' %}
      <p class="label-caps mt-8 mb-3">Opening soon</p>
      <h1 class="text-4xl">Energy you can wear.</h1>
      {%- if shop.password_message != blank -%}<p class="text-cb-muted mt-4 text-[14px]">{{ shop.password_message }}</p>{%- endif -%}
      {% form 'storefront_password', class: 'mt-8 flex' %}
        {%- if form.errors -%}<p class="w-full text-[12px] text-cb-danger mb-2">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label for="password" class="sr-only">Password</label>
        <input id="password" type="password" name="password" placeholder="Password" class="h-11 min-w-0 flex-1 border border-cb-line bg-white px-4 text-[14px] text-cb-ink placeholder:text-cb-faint focus:border-cb-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cb-rose transition-colors">
        <button type="submit" class="h-11 px-6 bg-cb-ink text-white text-[12px] uppercase tracking-[0.14em] hover:bg-black">Enter</button>
      {% endform %}
    </section>
  </main>
</body>
</html>
