---
import { u } from '../lib/url';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
const products = (await getCollection('products')).sort((a, b) => Number(b.data.bestseller) - Number(a.data.bestseller) || a.data.priceAED - b.data.priceAED);
const intentions = (await getCollection('intentions')).sort((a, b) => a.data.order - b.data.order);
const styles = [
  { id: 'all', label: 'All' },
  { id: 'women', label: 'Slim & women’s' },
  { id: 'men', label: 'Men’s' },
  { id: 'gold', label: 'Gold accent' },
  { id: 'new', label: 'New' },
];
---
<BaseLayout title="Shop all bracelets" description="Every Crystal Basket bracelet: natural crystal beads strung by intention, 6mm to 10mm, AED 199–349, delivered across the UAE.">
  <section class="container-x pt-12 md:pt-16 pb-8">
    <p class="eyebrow mb-2">Shop</p>
    <h1 class="text-4xl md:text-6xl">All bracelets</h1>
    <p class="text-muted mt-4 max-w-xl">{products.length} pieces. Natural stone only, hand-strung, cleansed before shipping. Any three become a stack at 15% off.</p>
  </section>
  <section class="container-x">
    <div class="flex flex-wrap gap-2 mb-3" role="tablist" aria-label="Filter by style">
      {styles.map((s) => (
        <button type="button" data-filter={s.id} class="filter-chip px-3.5 py-1.5 rounded-full border border-border text-[0.82rem] hover:border-text data-[active]:bg-text data-[active]:text-bg data-[active]:border-text" data-active={s.id === 'all' ? '' : undefined}>{s.label}</button>
      ))}
    </div>
    <div class="flex flex-wrap gap-2 mb-10">
      {intentions.map((i) => (
        <a href={u(`/intentions/${i.id}`)} class="px-3.5 py-1.5 rounded-full border border-border text-[0.82rem] text-muted hover:text-text hover:border-text">{i.data.short}</a>
      ))}
    </div>
    <div id="shop-grid">
      <ProductGrid products={products} eagerFirst={3} />
    </div>
  </section>
  <script>
    // Lightweight client-side filter over data attributes rendered in the grid.
    const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
    const cards = document.querySelectorAll<HTMLElement>('#shop-grid a[data-tags]');
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        chips.forEach((x) => x.removeAttribute('data-active'));
        c.setAttribute('data-active', '');
        const f = c.dataset.filter;
        cards.forEach((card) => {
          const tags = card.dataset.tags ?? '';
          card.style.display = f === 'all' || tags.split(' ').includes(f!) ? '' : 'none';
        });
      }),
    );
  </script>
</BaseLayout>
