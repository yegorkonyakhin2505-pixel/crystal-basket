---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WRIST_SIZES } from '../lib/format';
---
<BaseLayout title="Size guide" description="How to measure your wrist for a crystal bracelet, and which bead size to choose.">
  <section class="container-x pt-12 md:pt-20 pb-12 max-w-3xl">
    <p class="eyebrow mb-3">Size guide</p>
    <h1 class="text-4xl md:text-6xl leading-[1]">Measure once. Wear it every day.</h1>
    <p class="text-muted mt-6">A bracelet should sit snug enough not to spin, loose enough to slide a finger under. Here is how to get it right the first time.</p>
  </section>
  <section class="container-x pb-12 grid md:grid-cols-2 gap-8 max-w-5xl">
    <div class="p-6 rounded-brand border border-border bg-surface">
      <p class="eyebrow mb-4">How to measure</p>
      <ol class="space-y-3 text-[0.95rem] list-decimal list-inside">
        <li>Wrap a strip of paper or a soft tape snugly around your wrist, just below the wrist bone.</li>
        <li>Mark where it overlaps and measure the length in centimetres.</li>
        <li>That is your wrist size. Pick the bracelet size that lists it below. If you are between sizes, go up for 10mm beads and down for 6mm.</li>
      </ol>
    </div>
    <div class="p-6 rounded-brand border border-border bg-surface">
      <p class="eyebrow mb-4">Sizes</p>
      <table class="w-full text-[0.95rem]">
        <thead><tr class="text-left text-muted text-[0.78rem] uppercase tracking-wider"><th class="pb-2">Size</th><th class="pb-2">Bracelet</th><th class="pb-2">Fits wrist</th></tr></thead>
        <tbody class="divide-y divide-border">
          {(Object.keys(WRIST_SIZES) as ('S'|'M'|'L')[]).map((k) => (
            <tr><td class="py-2.5 font-medium">{k}</td><td class="py-2.5 tnum">{WRIST_SIZES[k].cm} cm</td><td class="py-2.5 tnum">{WRIST_SIZES[k].fits}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="text-[0.8rem] text-muted mt-4">Need a custom length? Message us on WhatsApp with your wrist measurement and we will string it to size at no extra cost.</p>
    </div>
  </section>
  <section class="container-x pb-20 max-w-5xl">
    <p class="eyebrow mb-4">Which bead size?</p>
    <div class="grid sm:grid-cols-3 gap-4">
      {[['6 mm', 'Slim and light. Best for smaller wrists, layering three or four, and wearing under a cuff or watch.'], ['8 mm', 'The classic. Visible without being loud, works on every wrist, our most-ordered size.'], ['10 mm', 'Statement weight. Suits larger wrists and men’s styling, usually worn alone or with one 6mm.']].map(([t, s]) => (
        <div class="p-5 rounded-brand border border-border bg-surface"><p class="font-display text-2xl">{t}</p><p class="text-[0.9rem] text-muted mt-2">{s}</p></div>
      ))}
    </div>
  </section>
</BaseLayout>
