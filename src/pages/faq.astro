---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import { productFaq } from '../data/faq';
import site from '../data/site.json';
const ordering = [
  { q: 'How do I pay?', a: 'Card checkout through our secure payment links where available, or order on WhatsApp and pay by card link, bank transfer or cash on delivery.' },
  { q: 'How fast is delivery?', a: `${site.deliveryCopy} Free over AED ${site.freeDeliveryAED}.` },
  { q: 'Can I exchange the size?', a: 'Yes. Unworn, within 14 days. We cover the courier once. If you send us your wrist measurement first, we will string it to size and you will not need to.' },
  { q: 'Do you gift-wrap?', a: 'Every bracelet ships in a linen pouch with its meaning card. Add a handwritten note in the WhatsApp order and we will include it.' },
];
---
<BaseLayout title="FAQ" description="Answers about wearing, cleansing, sizing and ordering Crystal Basket bracelets.">
  <section class="container-x pt-12 md:pt-20 pb-10 max-w-3xl">
    <p class="eyebrow mb-3">FAQ</p>
    <h1 class="text-4xl md:text-6xl leading-[1]">Things people ask us on WhatsApp.</h1>
  </section>
  <section class="container-x pb-12 max-w-3xl"><p class="eyebrow mb-4">Wearing & caring</p><FAQ items={productFaq} schema /></section>
  <section class="container-x pb-20 max-w-3xl"><p class="eyebrow mb-4">Ordering</p><FAQ items={ordering} /></section>
</BaseLayout>
