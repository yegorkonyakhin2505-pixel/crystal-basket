---
import { u } from '../../lib/url';
import { getCollection, getEntries, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import SectionHead from '../../components/SectionHead.astro';
import FAQ from '../../components/FAQ.astro';
import BuyBox from '../../components/BuyBox';
import site from '../../data/site.json';
import { productFaq } from '../../data/faq';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}
const { product } = Astro.props;
const d = product.data;
const stones = await getEntries(d.stones);
const intention = await getEntry(d.intention);
const secondary = await getEntries(d.secondaryIntentions);
const all = await getCollection('products');
const related = all
  .filter((p) => p.id !== product.id && (p.data.intention.id === intention.id || p.data.stones.some((s) => d.stones.some((x) => x.id === s.id))))
  .slice(0, 3);
const chakras = [...new Set(stones.flatMap((s) => s.data.chakra))];
const zodiac = [...new Set(stones.flatMap((s) => s.data.zodiac))];
const anyWaterUnsafe = stones.some((s) => !s.data.waterSafe);
const anySunUnsafe = stones.some((s) => !s.data.sunSafe);
const beadCount = (mm: number, cm: number) => Math.round((cm * 10) / mm);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${d.name} — ${d.subtitle}`,
  description: d.promise + ' ' + d.body,
  brand: { '@type': 'Brand', name: site.name },
  material: stones.map((s) => s.data.name).join(', '),
  offers: { '@type': 'Offer', priceCurrency: 'AED', price: d.priceAED, availability: d.inStock ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder', url: `${site.url}/products/${product.id}` },
};
---
<BaseLayout title={`${d.name} · ${d.subtitle}`} description={`${d.promise} ${d.body}`} jsonLd={jsonLd}>
  <nav class="container-x pt-6 text-[0.78rem] text-muted" aria-label="Breadcrumb">
    <a href={u('/shop')} class="hover:text-text">Shop</a> <span class="mx-1.5">/</span>
    <a href={u(`/intentions/${intention.id}`)} class="hover:text-text">{intention.data.name}</a> <span class="mx-1.5">/</span>
    <span class="text-text">{d.name}</span>
  </nav>

  <section class="container-x pt-6 pb-16 grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-14">
    <div class="grid grid-cols-[1fr_72px] sm:grid-cols-[1fr_88px] gap-3 items-start">
      <div class="rounded-brand overflow-hidden border border-border bg-surface-2">
        <ProductImage product={product} index={0} ratio="4/5" eager />
      </div>
      <div class="flex flex-col gap-3">
        {[0, 1, 2].map((i) => (
          <div class="rounded-brand overflow-hidden border border-border bg-surface-2 opacity-90">
            <ProductImage product={product} index={i} ratio="1/1" />
          </div>
        ))}
      </div>
    </div>

    <div class="lg:sticky lg:top-24 self-start">
      <p class="eyebrow mb-2">{d.triad.join(' · ')}</p>
      <h1 class="text-4xl md:text-5xl leading-[1]">{d.name}</h1>
      <p class="text-muted mt-2">{d.subtitle}</p>
      <p class="font-display text-[1.35rem] mt-5 italic max-w-md">{d.promise}</p>
      <div class="flex flex-wrap gap-1.5 mt-4">
        <a href={u(`/intentions/${intention.id}`)} class="px-2.5 py-1 rounded-full bg-accent text-on-accent text-[0.72rem] tracking-wide">{intention.data.short}</a>
        {secondary.map((s) => <a href={u(`/intentions/${s.id}`)} class="px-2.5 py-1 rounded-full border border-border text-[0.72rem] tracking-wide hover:border-text">{s.data.short}</a>)}
        {d.goldAccent && <span class="px-2.5 py-1 rounded-full border border-border text-[0.72rem] tracking-wide">14k gold-filled accent</span>}
        <span class="px-2.5 py-1 rounded-full border border-border text-[0.72rem] tracking-wide capitalize">{d.style}</span>
      </div>

      <div class="hairline my-7"></div>

      <BuyBox
        client:load
        name={d.name}
        priceAED={d.priceAED}
        compareAtAED={d.compareAtAED}
        beadSizes={d.beadSizes}
        defaultBead={d.defaultBead}
        sizes={d.sizes}
        inStock={d.inStock}
        stripePaymentLink={d.stripePaymentLink}
        freeDeliveryAED={site.freeDeliveryAED}
        deliveryCopy={site.deliveryCopy}
      />
    </div>
  </section>

  <section class="container-x grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-14 pb-16">
    <div class="space-y-12">
      <div class="reveal">
        <p class="eyebrow mb-3">The piece</p>
        <p class="text-[1.05rem] max-w-xl">{d.body}</p>
        <blockquote class="mt-6 border-l-2 border-accent-2 pl-4 font-display text-[1.4rem] italic">“{d.affirmation}”</blockquote>
      </div>

      <div class="reveal">
        <p class="eyebrow mb-4">Stones in this bracelet</p>
        <div class="grid sm:grid-cols-2 gap-3">
          {stones.map((s) => (
            <a href={u(`/stones/${s.id}`)} class="flex gap-4 p-4 rounded-brand border border-border bg-surface hover:border-text transition-colors">
              <span class="w-12 h-12 rounded-full shrink-0 ring-1 ring-black/10" style={`background: radial-gradient(circle at 35% 30%, ${s.data.palette[0]}, ${s.data.palette[1]})`}></span>
              <span>
                <span class="block font-display text-[1.15rem] leading-tight">{s.data.name}</span>
                <span class="block text-[0.78rem] text-accent mt-0.5">{s.data.keywords.join(' · ')}</span>
                <span class="block text-[0.82rem] text-muted mt-1.5 leading-snug">{s.data.description}</span>
              </span>
            </a>
          ))}
        </div>
      </div>

      <div class="reveal">
        <p class="eyebrow mb-4">Activate it</p>
        <ol class="grid sm:grid-cols-3 gap-3 text-[0.9rem]">
          {['Hold the bracelet in both hands and take three slow breaths.', `Say the intention out loud, three times: “${d.affirmation}”`, 'Put it on the wrist that feels right. Left to receive, right to project.'].map((t, i) => (
            <li class="p-4 rounded-brand bg-surface border border-border"><span class="font-display text-2xl text-accent-2 block mb-1">0{i + 1}</span>{t}</li>
          ))}
        </ol>
      </div>
    </div>

    <div class="space-y-3 reveal">
      <details class="group border border-border rounded-brand bg-surface p-5" open>
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium">Materials & dimensions <span class="text-muted group-open:rotate-45 transition-transform text-xl leading-none">+</span></summary>
        <dl class="mt-4 text-[0.88rem] grid grid-cols-[130px_1fr] gap-y-2 gap-x-3">
          <dt class="text-muted">Stones</dt><dd>{stones.map((s) => s.data.name).join(', ')}. Natural, undyed, A-grade.</dd>
          <dt class="text-muted">Bead sizes</dt><dd>{d.beadSizes.map((b) => `${b} mm`).join(' / ')}</dd>
          <dt class="text-muted">Lengths</dt><dd>S 16 cm · M 18 cm · L 20 cm</dd>
          <dt class="text-muted">Beads per piece</dt><dd>approx. {beadCount(d.defaultBead, 16)} (S) · {beadCount(d.defaultBead, 18)} (M) · {beadCount(d.defaultBead, 20)} (L) at {d.defaultBead} mm</dd>
          <dt class="text-muted">Cord</dt><dd>1 mm premium stretch cord, double-knotted</dd>
          {d.goldAccent && <><dt class="text-muted">Accent</dt><dd>14k gold-filled bead or spacer</dd></>}
          <dt class="text-muted">Chakra</dt><dd>{chakras.join(', ')}</dd>
          <dt class="text-muted">Zodiac</dt><dd>{zodiac.join(', ')}</dd>
        </dl>
      </details>
      <details class="group border border-border rounded-brand bg-surface p-5">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium">What’s in the box <span class="text-muted group-open:rotate-45 transition-transform text-xl leading-none">+</span></summary>
        <ul class="mt-4 text-[0.88rem] space-y-1.5">{d.includes.map((i) => <li>· {i}</li>)}</ul>
      </details>
      <details class="group border border-border rounded-brand bg-surface p-5">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium">Cleanse, charge & care <span class="text-muted group-open:rotate-45 transition-transform text-xl leading-none">+</span></summary>
        <div class="mt-4 text-[0.88rem] space-y-2 text-muted">
          <p>Cleanse on arrival and about once a month: overnight in moonlight, on a selenite plate, or with smoke.</p>
          {anyWaterUnsafe ? <p><strong class="text-text">Keep this one dry.</strong> One of its stones does not like water. Skip rinsing and use smoke, selenite or moonlight.</p> : <p>A quick rinse in plain water is fine. Dry it straight away.</p>}
          {anySunUnsafe && <p><strong class="text-text">Avoid long sun.</strong> One of these stones fades in sunlight. Charge it under the moon instead.</p>}
          <p>Roll it on and off rather than stretching over the hand. Remove before showers, sport and perfume. <a href={u('/care')} class="underline text-text">Full care guide</a>.</p>
        </div>
      </details>
      <details class="group border border-border rounded-brand bg-surface p-5">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium">Delivery & returns <span class="text-muted group-open:rotate-45 transition-transform text-xl leading-none">+</span></summary>
        <div class="mt-4 text-[0.88rem] space-y-2 text-muted">
          <p>{site.deliveryCopy} Free over AED {site.freeDeliveryAED}. Cash on delivery available.</p>
          <p>Wrong size? Swap it within 14 days, unworn, and we cover the courier once. Free re-string for life.</p>
        </div>
      </details>
      <p class="text-[0.72rem] text-muted pt-2">Natural stone varies. Colour, banding and flash will differ from the picture; that variation is proof it is real. Crystal meanings reflect traditional beliefs and are not medical advice. <a href={u('/disclaimer')} class="underline">Disclaimer</a>.</p>
    </div>
  </section>

  <section class="container-x pb-16">
    <SectionHead eyebrow="Complete the stack" title="Worn well together" href={u('/stacks')} linkLabel="Build a stack" />
    <ProductGrid products={related} />
  </section>

  <section class="container-x pb-20 max-w-3xl">
    <p class="eyebrow mb-5">Questions</p>
    <FAQ items={productFaq} schema />
  </section>
</BaseLayout>
