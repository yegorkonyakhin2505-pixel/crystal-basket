---
import { getCollection } from 'astro:content';
interface Props { limit?: number; compact?: boolean }
const { limit, compact = false } = Astro.props;
let intentions = (await getCollection('intentions')).sort((a, b) => a.data.order - b.data.order);
if (limit) intentions = intentions.slice(0, limit);
const products = await getCollection('products');
const count = (id: string) => products.filter((p) => p.data.intention.id === id || p.data.secondaryIntentions.some((s) => s.id === id)).length;
---
<div class:list={['grid gap-3 md:gap-4', compact ? 'grid-cols-2 md:grid-cols-4' : 'grid-cols-2 md:grid-cols-4']}>
  {intentions.map((i, idx) => (
    <a
      href={`/intentions/${i.id}`}
      class="group relative overflow-hidden rounded-brand border border-border bg-surface p-5 md:p-6 aspect-[4/5] md:aspect-[5/6] flex flex-col justify-end reveal"
      style={`transition-delay:${idx * 40}ms`}
    >
      <div
        class="absolute inset-0 opacity-70 group-hover:opacity-100 transition-opacity duration-500"
        style={`background: radial-gradient(80% 60% at 70% 20%, ${i.data.palette[0]}55, transparent 70%), radial-gradient(70% 50% at 20% 90%, ${i.data.palette[1]}44, transparent 70%);`}
      ></div>
      <div class="absolute top-5 right-5 flex -space-x-1">
        {[0, 1, 2].map((n) => (
          <span class="w-3.5 h-3.5 rounded-full ring-1 ring-black/10" style={`background: radial-gradient(circle at 35% 30%, ${n % 2 ? i.data.palette[0] : i.data.palette[1]}, ${n % 2 ? i.data.palette[1] : i.data.palette[0]});`}></span>
        ))}
      </div>
      <div class="relative">
        <p class="eyebrow mb-1.5">{i.data.triad.join(' · ')}</p>
        <h3 class="text-2xl md:text-[1.7rem] leading-tight">{i.data.short}</h3>
        <p class="text-[0.8rem] text-muted mt-1.5">{count(i.id)} bracelets</p>
      </div>
    </a>
  ))}
</div>
