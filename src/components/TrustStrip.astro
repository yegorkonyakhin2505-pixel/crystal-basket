---
import site from '../data/site.json';
const items = [
  { t: '100% natural stones', s: 'Never dyed, never glass. Variation is proof.' },
  { t: 'Cleansed & charged', s: 'Every piece rests on selenite for 48 hours before it ships.' },
  { t: `Same-day in ${site.city}`, s: 'Next-day across the UAE. Cash on delivery available.' },
  { t: 'Free re-string', s: 'If the cord ever gives, we restring it for free.' },
];
---
<section class="border-y border-border bg-surface">
  <div class="container-x grid grid-cols-2 lg:grid-cols-4 divide-y lg:divide-y-0 lg:divide-x divide-border">
    {items.map((i) => (
      <div class="py-6 lg:py-7 lg:px-6 first:pl-0 last:pr-0 reveal">
        <p class="text-[0.95rem] font-medium">{i.t}</p>
        <p class="text-[0.8rem] text-muted mt-1">{i.s}</p>
      </div>
    ))}
  </div>
</section>
