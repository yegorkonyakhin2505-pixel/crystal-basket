---
import type { CollectionEntry } from 'astro:content';
import ProductCard from './ProductCard.astro';
interface Props { products: CollectionEntry<'products'>[]; eagerFirst?: number; cols?: 3 | 4 }
const { products, eagerFirst = 0, cols = 3 } = Astro.props;
---
<div class:list={['grid grid-cols-2 gap-x-4 gap-y-8 md:gap-x-6', cols === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
  {products.map((p, i) => <ProductCard product={p} eager={i < eagerFirst} />)}
</div>
{products.length === 0 && <p class="text-muted">Nothing here yet.</p>}
