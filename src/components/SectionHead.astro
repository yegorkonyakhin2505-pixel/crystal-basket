---
interface Props { eyebrow?: string; title: string; text?: string; href?: string; linkLabel?: string; center?: boolean }
const { eyebrow, title, text, href, linkLabel = 'View all', center = false } = Astro.props;
---
<div class:list={['reveal mb-8 md:mb-10 flex flex-col gap-3', center ? 'items-center text-center' : 'md:flex-row md:items-end md:justify-between']}>
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
    <h2 class="text-3xl md:text-[2.6rem]">{title}</h2>
    {text && <p class="text-muted mt-3 max-w-xl">{text}</p>}
  </div>
  {href && <a href={href} class="text-[0.85rem] text-text underline underline-offset-4 decoration-border hover:decoration-text shrink-0">{linkLabel} →</a>}
</div>
