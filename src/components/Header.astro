---
import { u } from '../lib/url';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import Logo from './Logo.astro';
import { whatsappChatUrl } from '../lib/whatsapp';
import { base } from '../lib/url';

const intentions = (await getCollection('intentions')).sort((a, b) => a.data.order - b.data.order);
const stones = (await getCollection('stones')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const path = (base && Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname) || '/';
const nav = [
  { href: '/shop', label: 'Shop' },
  { href: '/intentions', label: 'Intentions', menu: 'intentions' },
  { href: '/stones', label: 'Stones', menu: 'stones' },
  { href: '/stacks', label: 'Stacks' },
  { href: '/about', label: 'Our story' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<div class="bg-accent text-on-accent text-[0.72rem] tracking-[0.12em] uppercase text-center py-2 px-4">
  {site.announcement}
</div>
<header class="sticky top-0 z-40 glass border-b border-border">
  <div class="container-x flex items-center justify-between h-16 lg:h-[72px]">
    <a href={u('/')} class="flex items-center gap-2.5" aria-label={site.name + ' home'}>
      <Logo class="w-7 h-7" />
      <span class="font-display text-[1.35rem] tracking-tight">{site.name}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {nav.map((item) => (
        <div class="relative group">
          <a
            href={u(item.href)}
            class:list={[
              'px-3.5 py-2 text-[0.9rem] rounded-brand transition-colors hover:bg-surface-2',
              isActive(item.href) ? 'text-text' : 'text-muted hover:text-text',
            ]}
          >{item.label}</a>
          {item.menu === 'intentions' && (
            <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:pointer-events-auto transition-all duration-200">
              <div class="w-[560px] bg-surface border border-border rounded-brand shadow-xl shadow-black/5 p-5 grid grid-cols-2 gap-1">
                {intentions.map((i) => (
                  <a href={u(`/intentions/${i.id}`)} class="flex items-start gap-3 p-2.5 rounded-brand hover:bg-surface-2 transition-colors">
                    <span class="mt-1 w-3 h-3 rounded-full shrink-0" style={`background: linear-gradient(135deg, ${i.data.palette[0]}, ${i.data.palette[1]})`}></span>
                    <span>
                      <span class="block text-[0.9rem]">{i.data.name}</span>
                      <span class="block text-[0.78rem] text-muted leading-snug">{i.data.tagline}</span>
                    </span>
                  </a>
                ))}
                <a href={u('/intentions')} class="col-span-2 mt-2 text-[0.8rem] text-accent hover:underline">All intentions →</a>
              </div>
            </div>
          )}
          {item.menu === 'stones' && (
            <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:pointer-events-auto transition-all duration-200">
              <div class="w-[520px] bg-surface border border-border rounded-brand shadow-xl shadow-black/5 p-5 grid grid-cols-3 gap-0.5">
                {stones.map((s) => (
                  <a href={u(`/stones/${s.id}`)} class="flex items-center gap-2.5 px-2.5 py-2 rounded-brand hover:bg-surface-2 transition-colors text-[0.88rem]">
                    <span class="w-3.5 h-3.5 rounded-full shrink-0 ring-1 ring-black/10" style={`background: radial-gradient(circle at 35% 35%, ${s.data.palette[0]}, ${s.data.palette[1]})`}></span>
                    {s.data.name}
                  </a>
                ))}
                <a href={u('/stones')} class="col-span-3 mt-2 text-[0.8rem] text-accent hover:underline">Stone library →</a>
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-1">
      <button id="mode-toggle" type="button" class="p-2.5 rounded-brand hover:bg-surface-2 transition-colors" aria-label="Toggle dark mode" title="Light / dark">
        <svg class="w-[18px] h-[18px] hidden [html[data-mode=light]_&]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="w-[18px] h-[18px] hidden [html[data-mode=dark]_&]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
      </button>
      <a href={whatsappChatUrl()} target="_blank" rel="noopener" class="hidden sm:inline-flex btn btn-outline !py-2 !px-4 text-[0.82rem]">WhatsApp us</a>
      <a href={u('/shop')} class="hidden sm:inline-flex btn btn-primary !py-2 !px-4 text-[0.82rem]">Shop</a>
      <button id="menu-open" type="button" class="lg:hidden p-2.5 rounded-brand hover:bg-surface-2" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-border bg-bg">
    <nav class="container-x py-4 flex flex-col gap-1" aria-label="Mobile">
      {nav.map((item) => (
        <a href={u(item.href)} class="py-2.5 text-lg font-display">{item.label}</a>
      ))}
      <div class="hairline my-2"></div>
      <p class="eyebrow mb-1">Shop by intention</p>
      <div class="grid grid-cols-2 gap-1">
        {intentions.map((i) => (
          <a href={u(`/intentions/${i.id}`)} class="py-1.5 text-[0.9rem] text-muted">{i.data.short}</a>
        ))}
      </div>
      <div class="flex gap-2 mt-4">
        <a href={u('/shop')} class="btn btn-primary flex-1">Shop bracelets</a>
        <a href={whatsappChatUrl()} class="btn btn-outline flex-1">WhatsApp</a>
      </div>
    </nav>
  </div>
</header>
<script>
  const toggle = document.getElementById('mode-toggle');
  toggle?.addEventListener('click', () => {
    const el = document.documentElement;
    const next = el.getAttribute('data-mode') === 'dark' ? 'light' : 'dark';
    el.setAttribute('data-mode', next);
    try { localStorage.setItem('cb-mode', next); } catch {}
    window.dispatchEvent(new CustomEvent('cb:mode', { detail: next }));
  });
  const open = document.getElementById('menu-open');
  const menu = document.getElementById('mobile-menu');
  open?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    open.setAttribute('aria-expanded', String(!hidden));
  });
</script>
