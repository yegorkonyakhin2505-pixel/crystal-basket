---
/** Renders the first real photo if present, else the generated bracelet art. */
import { getEntries, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import CrystalPlaceholder from './CrystalPlaceholder.astro';

interface Props {
  product: CollectionEntry<'products'>;
  index?: number;
  ratio?: '4/5' | '1/1' | '3/2';
  class?: string;
  eager?: boolean;
}
const { product, index = 0, ratio = '4/5', class: cls = '', eager = false } = Astro.props;
const stones = await getEntries(product.data.stones);
const intention = await getEntry(product.data.intention);
const img = product.data.images[index];
const bead = product.data.defaultBead;
---
{img ? (
  <img
    src={`/images/products/${product.id}/${img}`}
    alt={`${product.data.name} — ${product.data.subtitle}`}
    class={`block w-full h-full object-cover ${cls}`}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={`aspect-ratio: ${ratio};`}
  />
) : (
  <CrystalPlaceholder
    seed={`${product.id}-${index}`}
    palettes={stones.map((s) => s.data.palette)}
    wash={intention.data.palette}
    goldAccent={product.data.goldAccent}
    beadMm={index === 1 ? (bead === 6 ? 8 : 6) : bead}
    ratio={ratio}
    class={cls}
  />
)}
